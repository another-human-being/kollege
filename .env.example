DATABASE_URL=postgres://kollege:kollege@postgres:5432/kollege
APP_SECRET=            # Verschlüsselung für connections.config (npm run einrichten erzeugt ihn)
AUTH_SECRET=           # z. B. openssl rand -base64 32
APP_URL=http://localhost:3000
# Testphase: Mistral über den EU-Endpunkt (Entscheidung 24). Modell-IDs vor dem Start mit
# `npm run modell:liste` gegen das Konto prüfen und auf eine feste Version setzen.
MODEL_FAST=mistral:mistral-small-latest
MODEL_THINK=mistral:mistral-medium-3.5
MISTRAL_API_KEY=
MISTRAL_BASE_URL=      # leer = https://api.eu.mistral.ai/v1 (Verarbeitung nur in der EU)
# Alternativen: anthropic:claude-sonnet-5-5 (ANTHROPIC_API_KEY), openai-compatible:<modell> (MODEL_BASE_URL)
# ohne API-Schlüssel (Entwicklung/Tests, dev:reset): MODEL_FAST=oracle, MODEL_THINK=skript – nie in Produktion
ANTHROPIC_API_KEY=
MODEL_BASE_URL=        # optional: OpenAI-kompatibler EU-Anbieter / vLLM
MODEL_API_KEY=
BLOB_DIR=/data/blobs
DRIVE_MOUNT=/mnt/drive
TZ=Europe/Berlin
TEAM_DOMAIN=           # nur, wenn eine Domain allein dem Team gehört (eigene Subdomain); sonst leer – das Team sind die Adressen in config/team.json. Testdaten: gruendung.uni-augsburg.example
FREEMAIL_FILE=         # optional, Standard config/freemail.json; Testdaten: fixtures/freemail.json
# Push-Benachrichtigungen (Hinweise außerhalb der App): npm run einrichten erzeugt die Schlüssel.
# VAPID_SUBJECT ist die Kontaktadresse für die Push-Dienste (mailto:… oder https://…, nicht localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Websuche zu neuen Kontakten (Entscheidung 10.10.): an = Kollege sucht dienstliche Angaben (Organisation,
# Funktion) mit Mistrals Websuche; geschickt werden nur Name, Mail-Domain, bekannte Organisation.
WEBSUCHE=
MODEL_WEB=             # optional, Standard: das Modell aus MODEL_THINK
