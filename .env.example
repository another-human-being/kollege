DATABASE_URL=postgres://kollege:kollege@postgres:5432/kollege
APP_SECRET=            # Verschlüsselung für connections.config
AUTH_SECRET=           # z. B. openssl rand -base64 32
APP_URL=http://localhost:3000
MODEL_FAST=anthropic:claude-haiku-4-5
MODEL_THINK=anthropic:claude-sonnet-5-5
# ohne API-Schlüssel (Entwicklung/Tests): MODEL_FAST=oracle, MODEL_THINK=skript – nie in Produktion
# EU-Anbieter: MODEL_THINK=openai-compatible:<modell> mit MODEL_BASE_URL und MODEL_API_KEY
ANTHROPIC_API_KEY=
MODEL_BASE_URL=        # optional: OpenAI-kompatibler EU-Anbieter / vLLM
MODEL_API_KEY=
BLOB_DIR=/data/blobs
DRIVE_MOUNT=/mnt/drive
TZ=Europe/Berlin
TEAM_DOMAIN=           # z. B. gruendung.uni-augsburg.de; Testdaten: gruendung.uni-augsburg.example
FREEMAIL_FILE=         # optional, Standard config/freemail.json; Testdaten: fixtures/freemail.json
