{
  "name": "kollege",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env lib/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env lib/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:reset": "tsx lib/db/dev-reset.ts",
    "e2e": "playwright test",
    "modell:liste": "tsx --env-file-if-exists=.env lib/model/liste.ts",
    "modell:pruefen": "tsx --env-file-if-exists=.env lib/model/pruefen.ts",
    "einrichten": "tsx lib/einrichten.ts",
    "eval:chat": "vitest run --config vitest.eval.config.ts",
    "quelle:imap": "tsx --env-file-if-exists=.env lib/connectors/einrichten.ts",
    "eval:zuordnung": "EVAL=zuordnung vitest run --config vitest.eval.config.ts",
    "quelle:kalender": "tsx --env-file-if-exists=.env lib/connectors/kalender-einrichten.ts",
    "quelle:laufwerk": "tsx --env-file-if-exists=.env lib/connectors/laufwerk-einrichten.ts",
    "hinweise": "tsx --env-file-if-exists=.env lib/hinweise/cli.ts",
    "simulation": "playwright test --config playwright.simulation.config.ts",
    "kontakte:anreichern": "tsx --env-file-if-exists=.env lib/kontakte/cli.ts",
    "experiment:gespraech": "tsx --env-file-if-exists=.env lib/experiment/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/mistral": "^4.0.56",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@ai-sdk/react": "^4.0.130",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "ai": "^7.0.127",
    "drizzle-orm": "^0.45.3",
    "ical.js": "^2.2.1",
    "imapflow": "^2.2.1",
    "jszip": "^3.10.2",
    "mailparser": "^3.9.33",
    "mammoth": "^1.13.0",
    "next": "^16.3.8",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pg-boss": "^12.35.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdav": "^2.3.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "smtp-server": "^3.19.16",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
